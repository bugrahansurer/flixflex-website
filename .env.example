# ═══════════════════════════════════════════════════════════
# FlixFlex — Environment Variable Reference
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ═══════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────
DATABASE_URL=

# ── NextAuth ────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Set to "1" in development to enable the fallback admin account
# when the database is unavailable. NEVER set in production.
NEXTAUTH_FALLBACK_ADMIN=

# ── Cloudflare R2 (tüm medya: görsel, video, belge) ────────
# Sunucu S3 API'siyle yazar/siler; büyük dosyaları tarayıcı imzalı
# URL ile doğrudan yükler (bucket CORS'unda site origin'i olmalı).
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket'a bağlı public custom domain (sonda / olmadan),
# örn. https://cdn.flixflex.com.tr
R2_PUBLIC_BASE_URL=

# ── Upstash Redis (Rate Limiting) ───────────────────────────
# Optional — when both values are present, all rate limiters use
# Upstash Redis sliding-window (globally consistent across instances).
# When absent, an in-memory fixed-window fallback is used instead
# (per-instance; effective limit = max × serverless instance count).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI Providers ────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Email / Notifications ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Encryption ──────────────────────────────────────────────
ENCRYPTION_KEY=
